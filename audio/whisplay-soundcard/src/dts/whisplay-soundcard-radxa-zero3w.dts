/*
 * Device Tree overlay for Whisplay unified sound card on Radxa ZERO 3W.
 *
 * WM8960 or ES8389 is connected to the 40-pin header:
 *   PIN_3  SDA  -> I2C3_SDA_M0
 *   PIN_5  SCL  -> I2C3_SCL_M0
 *   PIN_12 BCLK -> I2S3_SCLK_M0
 *   PIN_35 LRCK -> I2S3_LRCK_RX_M0
 *   PIN_38 SDI  -> I2S3_SDI_M0
 *   PIN_40 SDO  -> I2S3_SDO_M0
 */

/dts-v1/;
/plugin/;

/ {
	compatible = "rockchip,rk3566";

	fragment@0 {
		target-path = "/";
		__overlay__ {
			es8389_mclk: es8389-mclk {
				compatible = "fixed-clock";
				#clock-cells = <0>;
				clock-frequency = <24576000>;
				clock-output-names = "es8389-mclk";
			};

			es8389_vddd: es8389-vddd {
				compatible = "regulator-fixed";
				regulator-name = "es8389-vddd";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			es8389_vdda: es8389-vdda {
				compatible = "regulator-fixed";
				regulator-name = "es8389-vdda";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};

	fragment@1 {
		target = <&i2c3>;
		__overlay__ {
			status = "okay";
			#address-cells = <1>;
			#size-cells = <0>;

			codec_es8389: whisplay@10 {
				compatible = "pisugar,whisplay";
				reg = <0x10>;
				#sound-dai-cells = <0>;
				clocks = <&es8389_mclk>;
				clock-names = "mclk";
				vddd-supply = <&es8389_vddd>;
				vdda-supply = <&es8389_vdda>;
				everest,mclk-src = /bits/ 8 <0x40>;
			};

			codec_wm8960: wm8960@1a {
				compatible = "wlf,wm8960";
				reg = <0x1a>;
				#sound-dai-cells = <0>;
				wlf,shared-lrclk;
			};
		};
	};

	fragment@2 {
		target = <&i2s3_2ch>;
		__overlay__ {
			status = "okay";
			rockchip,clk-trcm = <1>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2s3m0_sclk
				     &i2s3m0_lrck
				     &i2s3m0_sdi
				     &i2s3m0_sdo>;
		};
	};

	fragment@3 {
		target-path = "/";
		__overlay__ {
			sound {
				compatible = "pisugar,whisplay-soundcard";
				i2s-controller = <&i2s3_2ch>;
				whisplay,es8389-codec = <&codec_es8389>;
				whisplay,es8389-mclk-fs = <512>;
				whisplay,wm8960-codec = <&codec_wm8960>;
				whisplay,wm8960-sysclk = <12288000>;
				whisplay,wm8960-mclk-fs = <256>;
				whisplay,no-continuous-clock;
				status = "okay";
			};
		};
	};
};
